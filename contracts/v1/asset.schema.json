{
  "$defs": {
    "ContractVersion": {
      "enum": [
        "v1"
      ],
      "title": "ContractVersion",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A physical asset or component that can be the subject of a finding.",
  "properties": {
    "contract_version": {
      "$ref": "#/$defs/ContractVersion",
      "default": "v1",
      "description": "Wire version of this contract. Consumers must reject unknown major versions rather than guess field meaning."
    },
    "asset_id": {
      "description": "Globally unique asset identifier.",
      "title": "Asset Id",
      "type": "string"
    },
    "asset_type": {
      "description": "Domain-defined asset type, e.g. 'solar_panel'.",
      "title": "Asset Type",
      "type": "string"
    },
    "site_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Site Id"
    },
    "parent_asset_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Parent asset identifier for hierarchical assets.",
      "title": "Parent Asset Id"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    }
  },
  "required": [
    "asset_id",
    "asset_type"
  ],
  "title": "Asset",
  "type": "object",
  "$id": "https://athena-forge.dev/schemas/v1/asset.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
