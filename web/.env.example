# Copy to .env and fill in. Never commit .env.
# Generate a key:  python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
ATHENA_ALLOWED_HOSTS=console.example.com
ATHENA_CSRF_TRUSTED_ORIGINS=https://console.example.com
# Auto-labelling: "sam" (SAM + CLIP in the worker) or "disabled".
# CLIP ships ENABLED by default. Its Hugging Face repo declares no licence and its model card says
# deployed use is out of scope; the project owner accepted that risk for the default setup (2026-10-17),
# which is NOT a legal clearance and does not transfer to you. Take your own advice before commercial
# use. Set "disabled" to switch auto-labelling off. See DEPLOYMENT.md, "Licences and model terms".
ATHENA_AUTOLABEL_BACKEND=sam
# To use a different classifier, uncomment and set a Hugging Face id that loads with transformers' CLIPModel.
# Default: openai/clip-vit-base-patch32. A different model needs its own licence and quality review.
# ATHENA_CLIP_MODEL=openai/clip-vit-base-patch32
# After the first run has cached the weights, set 0 to forbid further downloads.
ATHENA_AUTOLABEL_ALLOW_DOWNLOAD=1
# Teaching (model training). Both are read by the web process and by the training worker.
# Name of the training tool used for new runs. The built-in one is "torchvision-fasterrcnn".
ATHENA_TRAINING_BACKEND=torchvision-fasterrcnn
# Seconds after which a run still marked "running" is failed by the worker (whole number;
# 21600 = 6 hours). Raise it for long CPU runs, lower it to give up on stuck runs sooner.
ATHENA_TRAINING_RUN_TIMEOUT=21600
# Ready-made starting models in the Teach panel ("Advanced: start from a ready-made model"). 0 (default) = nothing is
# downloaded and those choices are greyed out unless the weights are already cached. 1 = the training worker may download
# them once (about 21 MB and 74 MB) from download.pytorch.org. They carry their own terms: read the licence note in the panel
# and docs/guides/model-quality.md first, and ask a lawyer before commercial use. Read by the training worker (which
# downloads) and shown by the console; docker-compose gives every service this file, so they agree.
ATHENA_TRAINING_ALLOW_DOWNLOAD=0
# Access roles (see docs/guides/access-roles.md). Run `python manage.py athena_roles` to create the groups and assign people.
# What a signed-in user in none of the four Athena groups can do: "labeler" (default) or "viewer" (read-only). They can never approve.
ATHENA_UNASSIGNED_ROLE=labeler
# 1 = the person who started a teaching run cannot approve that run's model (separation of duties). Default off.
ATHENA_APPROVAL_REQUIRES_SECOND_PERSON=0
