# Athena console — copy to `.env` and fill in the required values.
#   cp .env.example .env
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Never commit `.env`. See DEPLOYMENT.md for the full table.

# Required in production (DEBUG off)
DJANGO_SECRET_KEY=
ATHENA_ALLOWED_HOSTS=console.example.com
ATHENA_CSRF_TRUSTED_ORIGINS=https://console.example.com

# Local development: DJANGO_DEBUG=1 skips the secret-key/host requirements
# DJANGO_DEBUG=1

# Reverse proxy
ATHENA_BEHIND_PROXY=1
ATHENA_SECURE_SSL=1
ATHENA_HSTS_SECONDS=31536000
ATHENA_DATA_HOME=/data

# Sessions and lockout
ATHENA_SESSION_HOURS=12
ATHENA_LOGIN_MAX_FAILURES=8
ATHENA_LOGIN_LOCKOUT_SECONDS=900
ATHENA_TRUST_FORWARDED_FOR=0

# gunicorn
# ATHENA_WEB_WORKERS=4
ATHENA_WEB_THREADS=2
ATHENA_WEB_TIMEOUT=120

# Auto-label worker. `disabled` hides the feature.
ATHENA_AUTOLABEL_BACKEND=sam
ATHENA_AUTOLABEL_ALLOW_DOWNLOAD=0
ATHENA_AUTOLABEL_DEVICE=auto

# Training helper. Console Access > "Ready-made model downloads" wins over this.
ATHENA_TRAINING_ALLOW_DOWNLOAD=0

# Built-in vision-language model (optional; each user can also set their own)
# ATHENA_VLM_BASE_URL=
# ATHENA_VLM_MODEL=qwen2.5vl:7b
# ATHENA_VLM_API_KEY=

ATHENA_LOG_LEVEL=INFO
ATHENA_UNASSIGNED_ROLE=labeler
